    </TestPlan>
    <hashTree>
<Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Environnement (propriétés -q env/*.properties)"><collectionProp name="Arguments.arguments"><elementProp name="protocole" elementType="Argument"><stringProp name="Argument.name">protocole</stringProp><stringProp name="Argument.value">${__P(protocole,http)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="hote" elementType="Argument"><stringProp name="Argument.name">hote</stringProp><stringProp name="Argument.value">${__P(hote,localhost)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="port" elementType="Argument"><stringProp name="Argument.name">port</stringProp><stringProp name="Argument.value">${__P(port,4020)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="tenant" elementType="Argument"><stringProp name="Argument.name">tenant</stringProp><stringProp name="Argument.value">${__P(tenant,default)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="comptes" elementType="Argument"><stringProp name="Argument.name">comptes</stringProp><stringProp name="Argument.value">${__P(comptes,donnees/comptes.csv)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="identifiants" elementType="Argument"><stringProp name="Argument.name">identifiants</stringProp><stringProp name="Argument.value">${__P(identifiants,donnees/identifiants.csv)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="utilisateurs" elementType="Argument"><stringProp name="Argument.name">utilisateurs</stringProp><stringProp name="Argument.value">${__P(utilisateurs,1)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="montee" elementType="Argument"><stringProp name="Argument.name">montee</stringProp><stringProp name="Argument.value">${__P(montee,1)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="duree" elementType="Argument"><stringProp name="Argument.name">duree</stringProp><stringProp name="Argument.value">${__P(duree,30)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="reflexion" elementType="Argument"><stringProp name="Argument.name">reflexion</stringProp><stringProp name="Argument.value">${__P(reflexion,0)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="debit" elementType="Argument"><stringProp name="Argument.name">debit</stringProp><stringProp name="Argument.value">${__P(debit,20)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="unites_operation" elementType="Argument"><stringProp name="Argument.name">unites_operation</stringProp><stringProp name="Argument.value">${__P(unites_operation,10)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="duree_operation" elementType="Argument"><stringProp name="Argument.name">duree_operation</stringProp><stringProp name="Argument.value">${__P(duree_operation,600)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="ecritures" elementType="Argument"><stringProp name="Argument.name">ecritures</stringProp><stringProp name="Argument.value">${__P(ecritures,true)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="seuil_lecture" elementType="Argument"><stringProp name="Argument.name">seuil_lecture</stringProp><stringProp name="Argument.value">${__P(seuil_lecture,500)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="seuil_ecriture" elementType="Argument"><stringProp name="Argument.name">seuil_ecriture</stringProp><stringProp name="Argument.value">${__P(seuil_ecriture,1000)}</stringProp><
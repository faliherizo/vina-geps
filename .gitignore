# Généré au build ou au déploiement — jamais versionné.
backend-java/target/
frontend/node_modules/
frontend/dist/
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
infra/terraform/**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars.local
.env
.env.*
*.db
*.db-wal
*.db-shm
.DS_Store
backend-java/data/

# Index local de GitNexus (gitnexus analyze)
.gitnexus/

# Identifiants générés par scripts/creer-organisme-par-defaut.cjs — jamais versionnés.
scripts/.organisme-par-defaut.*.local.json
# Démonstration geps (deploy/geps) : l'état d'un serveur et les accès remis en main propre, jamais versionnés.
# (.env.geps est déjà couvert par « .env.* ».)
deploy/geps/.version-*
deploy/geps/*.local*
# Tests d'intrusion (securite/intrusion) : l'état d'une campagne et ses résultats bruts restent sur le poste ou l'artefact.
securite/intrusion/.etat-*.local.json
securite/intrusion/resultats/
# Jetons de session de la campagne e2e (réécrits à chaque passage) et résultats bruts JMeter (journaux qui citent les
# secrets des clients d'API de campagne) : ils ne se versionnent pas (gitleaks, pipeline DevSecOps, 22 nov. 2026).
e2e/.auth/
perf/jmeter/resultats/

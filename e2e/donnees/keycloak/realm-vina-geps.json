              "subGroups": []
            },
            {
              "name": "Paramédics",
              "path": "/Urgences-santé/Opérations/Paramédics",
              "realmRoles": [],
              "subGroups": []
            }
          ]
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "vina-geps",
      "name": "VINA GEPS",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "vina-geps-secret-essai-uniquement",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5331/api/auth/sso/annuaires/callback",
        "http://localhost:5173/api/auth/sso/annuaires/callback",
        "http://localhost:5340/api/auth/sso/annuaires/callback",
        "http://localhost:8095/api/auth/sso/annuaires/callback",
        "http://localhost:4031/api/auth/sso/annuaires/callback",
        "http://localhost:4000/api/auth/sso/annuaires/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "email",
        "basic"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],

            "vina-rh"
          ],
          "subGroups": []
        },
        {
          "name": "Opérations",
          "path": "/Urgences-santé/Opérations",
          "realmRoles": [
            "vina-employe"
          ],
          "subGroups": [
            {
              "name": "Chefs d'équipe",
              "path": "/Urgences-santé/Opérations/Chefs d'équipe",
              "realmRoles": [
                "vina-chef"

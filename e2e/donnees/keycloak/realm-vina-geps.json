  "roles": {
    "realm": [
      {
        "name": "vina-employe",
        "description": "Employé : son horaire, sa feuille de temps, ses demandes."
      },
      {
        "name": "vina-chef",
        "description": "Chef d'équipe : l'encadrement de son unité.",
        "composite": true,
        "composites": {
          "realm": [
            "vina-employe"
          ]
        }
      },
      {
        "name": "vina-directeur",

        { "pourquoi": "Le type déclaré se vérifie : un nombre n'est pas un texte", "methode": "POST", "chemin": "/api/effectifs/planification/postes", "corps": { "code": "3412-J0", "libelle": "PSA jour", "uniteCode": "EST", "statutEmploiCode": "TC", "corpsEmploiCode": "PARA", "milieuId": "{{c12}}", "natureCode": "REG", "cycle": [["J", "J", "J", null, null, null, null]], "debutCycle": "2030-03-18", "parametres": { "VEHICULE": 12 } }, "attendu": { "statut": 422 } },

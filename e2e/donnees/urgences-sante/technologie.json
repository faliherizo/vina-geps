      "variableSecret": "ANNUAIRE_KEYCLOAK",
      "domaines": [
       "urgences-sante.qc.ca"
      ],
      "roleParDefaut": "employee"
     },
     "attendu": {
      "statut": 201
     }
    },
    {
     "methode": "POST",
     "chemin": "/api/auth/annuaires",
     "corps": {

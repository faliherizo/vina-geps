      "clientId": "CN=svc-geps,DC=us,DC=local",
      "variableSecret": "ANNUAIRE_AD",
      "domaines": [
       "urgences-sante.qc.ca"
      ],
      "roleParDefaut": "employee"
     },
     "attendu": {
      "statut": 201
     }
    },
    {
     "methode": "GET",
     "chemin": "/api/auth/annuaires",
     "attendu": {
      "statut": 200,
      "texte": "AD du siège"
     }
    },
    {
     "acteur": "julie",
     "methode": "GET",
     "chemin": "/api/auth/annuaires",
     "attendu": {
      "statut": 403
     }
    }
   ]
  },
  {

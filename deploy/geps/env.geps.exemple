# VINA GePS — démonstration publique (geps.vinaitsolution.com) : gabarit de deploy/geps/.env.geps sur le serveur.
#
# Ne pas remplir à la main : deploy/geps/preparer-serveur.sh crée .env.geps à partir de ce gabarit, tire chaque secret
# au hasard (openssl rand) et pose le mode 600. Il ne réécrit jamais un .env.geps existant.
# .env.geps n'est PAS suivi par git (.gitignore : .env.*). Aucune valeur réelle ici.

# ── Interpolation de la composition (lues par `docker compose --env-file`) ──
# La plage du réseau Docker `web` (docker network inspect web) : le Nginx central y vit.
GEPS_PROXIES_CONFIANCE=172.19.0.0/16

# ── Le socle ──
# HS256 : 32 octets au moins. Changer ce secret ferme toutes les sessions ouvertes.
JWT_SECRET=__ALEATOIRE__
COOKIE_SECURE=1
HTTPS=1
CORS_ORIGINS=https://geps.vinaitsolution.com
PUBLIC_APP_URL=https://geps.vinaitsolution.com
PUBLIC_API_URL=https://geps.vinaitsolution.com
# Le choix de l'organisme se fait à l'écran de connexion (un seul hôte, pas de sous-domaine par organisme).
TENANT_RESOLUTION=selecteur

# Le compte d'exploitation de la plateforme : le seul qui ne se publie pas (docs/COMPTES-DEMO-GEPS.md).
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=__ALEATOIRE__
# Le compte `admin` créé au tout premier démarrage (base vide), hors de tout organisme de démonstration.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__ALEATOIRE__

# ── Mode démonstration ──
# Les tiers embarqués parlent les vrais protocoles (Entra, SAML, Twilio, clamd…), sans compte ni envoi réel.
# Aucun texto, aucun courriel ne part de la démonstration.
DEMONSTRATION_INTEGRATIONS=entra,saml,sms,antivirus,api,webhooks

# ── Exploitation ──
LOG_FORMAT=json
LOG_NIVEAU=info
REGION_DONNEES=ovh-vps
HEBERGEUR=OVH VPS — démonstration
SAUVEGARDES_INTERVALLE_MIN=60

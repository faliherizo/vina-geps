<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nexu VINA — backend Java / Spring Boot.

  Projet **séparé** du backend Node : celui-ci reste la référence en production pendant toute la
  migration, et n'est pas modifié. Les deux coexistent derrière nginx, module par module
  (voir docs/PLAN-MIGRATION-BACKEND-JAVA.md, partie 3 — étranglement).

  Choix de versions :
    - Java 25 LTS : version installée sur le poste, supportée par Spring Boot 4.
    - Spring Boot 4.0.7 : dernier correctif d'une ligne mineure établie, préféré à la 4.1.0
      (première de sa ligne) pour un chantier qui va durer plusieurs mois.
    - Pas de spring-boot-starter-data-jpa : l'accès aux données se fait par `JdbcClient`, pour
      transposer les 916 instructions SQL existantes plutôt que de les réécrire en JPA. Voir la
      partie 5 du plan.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.7</version>
    <relativePath/>
  </parent>

  <groupId>ca.vina</groupId>
  <artifactId>nexu-vina-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Nexu VINA — backend</name>
  <description>Backend Java/Spring Boot — migration à contrat HTTP figé depuis le backend Node</description>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jjwt.version>0.12.6</jjwt.version>
    <archunit.version>1.5.0</archunit.version>
    <cucumber.version>7.34.2</cucumber.version>
  </properties>

  <dependencies>
    <!-- SFTP des lots d'intégration (AO 26-015-DO, addenda 06, réponse 3) : client en production,
         serveur en mémoire dans les essais. 2.15 corrige Terrapin (CVE-2023-48795). -->
    <dependency>
      <groupId>org.apache.sshd</groupId>
      <artifactId>sshd-sftp</artifactId>
      <version>2.15.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Classeurs Excel (exports scolaires, grille 17) et PDF (bordereaux, incidents, factures) : les mêmes fichiers que le Node. -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.4.1</version>
    </dependency>
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.2</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <!-- Courrier sortant réel (remise des accès, avis de soutien) dès que SMTP_HOST est réglé ; journal sinon. -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      spring-security-crypto seul, sans le starter complet : à ce stade on a besoin de
      `BCryptPasswordEncoder` pour vérifier les empreintes héritées de bcryptjs, pas de la
      chaîne de filtres de Spring Security — qui imposerait son propre modèle d'authentification
      alors que le contrat (cookie `session` + double-submit CSRF) est figé par le front.
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!--
      SQLite pendant l'étranglement : les deux backends partagent le **même fichier**, déjà en
      mode WAL, qui autorise l'accès concurrent multi-processus. Le passage à PostgreSQL est une
      phase terminale, après retrait du Node (voir le plan, partie 0).
    -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.50.1.0</version>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Liquibase : versionnage du schéma, en **baseline** sur les 35 migrations du Node.

      C'est le *starter* qu'il faut, pas `liquibase-core` seul : Spring Boot 4 a scindé ses
      auto-configurations en modules, et `liquibase-core` sur le chemin de classes ne suffit plus
      à déclencher la migration au démarrage — elle échoue en silence, ce qui est pire qu'une
      erreur.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-liquibase</artifactId>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <!--
      BDD : les exigences de l'avis 26-015-DO en Gherkin (src/bdd), jouées par Cucumber contre le
      serveur démarré pour de vrai (base vierge bâtie par Liquibase). Voir src/bdd/README.md.
    -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        src/bdd vit à côté de src/main et src/test : les scénarios Gherkin des exigences et leurs
        étapes. Maven les compile et les joue comme des essais (phase test), avec les autres.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>sources-bdd</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration><sources><source>src/bdd/java</source></sources></configuration>
          </execution>
          <execution>
            <id>ressources-bdd</id>
            <phase>generate-test-resources</phase>
            <goals><goal>add-test-resource</goal></goals>
            <configuration><resources><resource><directory>src/bdd/resources</directory></resource></resources></configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        JaCoCo — couverture par couche, aux seuils des standards du dépôt.

        Le seuil est un **plancher, pas un objectif** : une couverture élevée prouve que le code
        a été exécuté, jamais qu'il a été vérifié. C'est le test de mutation qui distingue les
        deux, et il viendra quand le périmètre migré le justifiera.

        Les contrôleurs et adaptateurs sont exclus du décompte : leur vérification passe par le
        diff de contrat et les tests e2e, pas par des tests unitaires qui simuleraient la moitié
        de Spring pour prouver qu'un appel est délégué.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.13</version>
        <configuration>
          <!--
            Exclusions nominatives, une par classe, avec son motif. Jamais de motif par paquet :
            « infrastructure/** » exclurait aussi le prochain adaptateur, celui que personne
            n'aura relu. Les contrôleurs cités sont ceux des modules dont le contrat est éprouvé
            par diff contre le Node et par e2e ; chaque module finalisé retire le sien de cette
            liste en gagnant son test HTTP (voir ControleurScolaire, ControleurHoraires).
          -->
          <excludes>
            <exclude>ca/vina/nexu/ApplicationNexuVina.class</exclude>                                  <!-- point d'entrée main -->
            <exclude>ca/vina/nexu/partage/web/ConfigurationWeb.class</exclude>                        <!-- configuration déclarative -->
            <exclude>ca/vina/nexu/tresorerie/infrastructure/configuration/ConfigurationTresorerie.class</exclude>  <!-- configuration déclarative : choix Flinks/simulateur par l'environnement -->
            <exclude>ca/vina/nexu/superadmin/infrastructure/configuration/ConfigurationSuperadmin.class</exclude>  <!-- configuration déclarative : aléa et URL publique -->
            <exclude>ca/vina/nexu/partage/web/ControleurRoutes.class</exclude>                        <!-- inventaire des routes, diff de contrat -->
            <exclude>ca/vina/nexu/comptabilite/infrastructure/web/ControleurComptabilite.class</exclude>  <!-- idem -->
            <exclude>ca/vina/nexu/integrations/infrastructure/web/ControleurIntegrations.class</exclude>  <!-- idem -->
            <exclude>ca/vina/nexu/integrations/infrastructure/web/ControleurOAuth.class</exclude>         <!-- idem -->
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>prepare</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>rapport</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>seuils</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <!--
                  Domaine : logique pure, sans E/S. Les modules portés en dernier (scolaire, horaires,
                  ordonnanceur) sont à 100 % de lignes ; les premiers (facturation, comptabilité, vitrine)
                  gardent quelques branches sans essai — le seuil est celui qu'ils atteignent, et il ne
                  redescendra pas.
                -->
                <rule>
                  <element>PACKAGE</element>
                  <includes><include>ca.vina.nexu.*.domaine</include></includes>
                  <limits>
                    <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.96</minimum></limit>
                    <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                  </limits>
                </rule>
                <!-- Les domaines des modules portés dans ce lot : 100 % de lignes, 98 % de branches. -->
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>ca.vina.nexu.scolaire.domaine</include>
                    <include>ca.vina.nexu.horaires.domaine</include>
                    <include>ca.vina.nexu.ordonnanceur.domaine</include>
                  </includes>
                  <limits>
                    <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>1.00</minimum></limit>
                    <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.98</minimum></limit>
                  </limits>
                </rule>
                <!-- Global : ≥ 96 % lignes, ≥ 92 % branches — un cliquet, jamais redescendu. -->
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.96</minimum></limit>
                    <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.92</minimum></limit>
                  </limits>
                </rule>
                <!--
                  Chaque classe, isolément, ≥ 96 % de lignes : l'agrégé dit si le projet est testé, cette
                  règle dit s'il l'est uniformément. Le rapport nomme la classe fautive avec son chiffre.
                -->
                <rule>
                  <element>CLASS</element>
                  <limits>
                    <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.96</minimum></limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
